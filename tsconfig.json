{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@sim/*": ["src/sim/*"],
      "@data/*": ["src/data/*"],
      "@render/*": ["src/render/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["src", "tools", "tests"]
}
